{
  "name": "lsngrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:grace": "node --import tsx scripts/validate-grace.ts",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "format": "prettier --write src server tests scripts/*.ts docs/*.md docs/**/*.md README.md package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json",
    "format:check": "prettier --check src server tests scripts/*.ts docs/*.md docs/**/*.md README.md package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json",
    "test:native": "node --import tsx scripts/test-native.ts",
    "benchmark": "node --import tsx scripts/benchmark-performance.ts",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:linux": "npm run desktop:prepare && electron-builder --linux AppImage deb --publish never",
    "desktop:windows": "npm run desktop:prepare && electron-builder --win nsis --publish never",
    "desktop:release": "npm run desktop:prepare && electron-builder --publish always"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "electron-updater": "^6.8.11",
    "immer": "^11.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "main": "dist-desktop/main.cjs",
  "description": "LSNGrace — editor científico de gráficos Grace",
  "author": "LSNGrace contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/intcarlosmiguel/LSNGrace.git"
  },
  "build": {
    "appId": "org.lsngrace.desktop",
    "productName": "LSNGrace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@resvg/**/*"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "intcarlosmiguel",
        "repo": "LSNGrace",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "LSNGrace contributors",
      "executableName": "lsngrace",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "grace",
        "python3",
        "libcairo2",
        "librsvg2-2"
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
