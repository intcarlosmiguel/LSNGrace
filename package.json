{
  "name": "lsngrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:grace": "node --import tsx scripts/validate-grace.ts",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "format": "prettier --write src server tests scripts/*.ts docs/*.md docs/**/*.md README.md package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json",
    "format:check": "prettier --check src server tests scripts/*.ts docs/*.md docs/**/*.md README.md package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json",
    "test:native": "node --import tsx scripts/test-native.ts",
    "benchmark": "node --import tsx scripts/benchmark-performance.ts"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "immer": "^11.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
